diff --git a/binaries/data/mods/public/gui/session/third_person_camera.js b/binaries/data/mods/public/gui/session/third_person_camera.js
new file mode 100644
index 00000000..722af121
--- /dev/null
+++ b/binaries/data/mods/public/gui/session/third_person_camera.js
@@ -0,0 +1,24 @@
+/** Third-person mode for the first selected unit. RTS mode remains available with F. */
+var g_ThirdPersonCameraEnabled = true;
+
+function updateThirdPersonCamera()
+{
+	if (!g_ThirdPersonCameraEnabled)
+		return;
+
+	let unit = g_Selection.getFirstSelected();
+	let state = unit && GetEntityState(unit);
+	if (state && hasClass(state, "Unit"))
+		Engine.CameraFollowThirdPerson(unit);
+	else
+		Engine.CameraFollowThirdPerson(0);
+}
+
+function toggleThirdPersonCamera()
+{
+	g_ThirdPersonCameraEnabled = !g_ThirdPersonCameraEnabled;
+	if (g_ThirdPersonCameraEnabled)
+		updateThirdPersonCamera();
+	else
+		Engine.CameraFollowThirdPerson(0);
+}
