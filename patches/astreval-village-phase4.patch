+# Astreval village: deterministic test harness
+
+From the 0 A.D. repository root:
+
+```sh
+node tools/astreval_village_tests/quest_simulation.test.js
+node tools/astreval_village_tests/camera_gui.test.js
+```
+
+These scripts exercise the real map trigger, network command dispatcher,
+GUI controls and selection code with mock engine components. They do not replace
+a Pyrogenesis integration or GPU performance test.
diff --git a/tools/astreval_village_tests/camera_gui.test.js b/tools/astreval_village_tests/camera_gui.test.js
new file mode 100644
index 00000000..10ca7965
--- /dev/null
+++ b/tools/astreval_village_tests/camera_gui.test.js
@@ -0,0 +1,68 @@
+/* GUI-only mock test. Real rendering still requires Pyrogenesis. */
+const assert=require('node:assert/strict'), fs=require('node:fs'), vm=require('node:vm'), path=require('node:path');
+const dir=path.join(__dirname,'../../binaries/data/mods/public/gui/session');
+const events=[],objects={};
+const states={
+  1:{player:1,identity:{controllable:true},unitAI:{},position:{x:10,z:10},rotationY:0,classes:['Unit','AstrevalHero'],astrevalCombat:{drawn:false,stamina:100,combo:0}},
+  2:{player:1,identity:{controllable:true},unitAI:{},position:{x:20,z:20},rotationY:0,classes:['Unit','Infantry']}
+};
+const selection={selected:1,getFirstSelected(){return this.selected;},size(){return this.selected?1:0;},reset(){this.selected=0;},addList(ents){this.selected=ents[0];}};
+let view={quest:'Parler à l’ancienne.',reputation:0,stage:'intro',nearby:'Ancienne',dialogue:null};
+const ctx={
+  g_Disconnected:false,g_Selection:selection,controlsPlayer:p=>p===1,
+  GetEntityState:id=>states[id]||null,hasClass:(s,cls)=>s?.classes.includes(cls),
+  translate:s=>s,sprintf:(s,opts)=>s.replace(/%\(([^)]+)\)s/g,(_,key)=>opts[key]),
+  GetSimState:()=>({cinemaPlaying:false}),
+  registerConfigChangeHandler:()=>{},
+  Engine:{
+    ConfigDB_GetValue:()=>'',
+    GetPlayerID:()=>1,IsPaused:()=>false,GetFollowedEntity:()=>0,
+    GuiInterfaceCall(name,data){
+      if (name==='GetAstrevalVillageState') return data.hero ? view : {...view,nearby:'',dialogue:null};
+      if (name==='GetPlayerEntities') return [2,1];
+      if (name==='SetSelectionHighlight') events.push(['marker',data]);
+      return null;
+    },
+    GetGUIObjectByName(name){return objects[name]??=({hidden:true,caption:''});},
+    CameraFollowThirdPerson(ent){events.push(['camera',ent]);},
+    PostNetworkCommand(cmd){events.push(['command',cmd]);}
+  }
+};
+vm.createContext(ctx);
+for (const file of ['selection.js','character_controller.js','third_person_camera.js','astreval_village_ui.js'])
+  vm.runInContext(fs.readFileSync(path.join(dir,file),'utf8'),ctx,{filename:file});
+ctx.g_Selection=selection; // replace native selector with the simplified selection fixture
+ctx.g_CharacterController=vm.runInContext('new CharacterController()',ctx);
+ctx.g_AstrevalVillageUI=vm.runInContext('new AstrevalVillageUI()',ctx);
+ctx.updateThirdPersonCamera();
+assert.equal(events.at(-2)[0],'camera');
+assert.equal(events.at(-2)[1],1);
+assert.equal(events.at(-1)[1].selected,false,'selected hero star hidden in TPS');
+ctx.g_AstrevalVillageUI.update();
+assert.equal(objects.astrevalQuestJournal.hidden,false);
+assert.equal(objects.astrevalTalkPrompt.hidden,false);
+ctx.g_AstrevalVillageUI.interact();
+assert.equal(events.at(-1)[1].type,'astreval-interact');
+view={...view,dialogue:{speaker:'Ancienne',text:'Défendez le village.',choices:['Oui','Plus tard']}};
+ctx.g_AstrevalVillageUI.update();
+assert(ctx.g_AstrevalVillageUI.dialogueActive);
+assert.equal(objects.astrevalDialoguePanel.hidden,false);
+assert.equal(objects.astrevalChoice2.hidden,true);
+ctx.g_AstrevalVillageUI.choose(0);
+assert.equal(events.at(-1)[1].choice,0);
+assert.equal(ctx.g_CharacterController.combat('equip'),false,'combat disabled in dialogue');
+view={...view,dialogue:null};
+ctx.g_AstrevalVillageUI.update();
+ctx.toggleThirdPersonCamera();
+assert.equal(vm.runInContext('g_ThirdPersonCameraEnabled',ctx),false);
+assert(events.some(e=>e[0]==='marker'&&e[1].selected&&e[1].alpha>=0.65), 'star restored in RTS');
+selection.selected=2;
+ctx.updateThirdPersonCamera();
+assert.equal(vm.runInContext('g_ThirdPersonCameraEnabled',ctx),false);
+ctx.selectCharacter();
+assert.equal(selection.selected,1);
+assert.equal(vm.runInContext('g_ThirdPersonCameraEnabled',ctx),true,'F4 returns to hero TPS');
+selection.selected=2;
+ctx.updateThirdPersonCamera();
+assert.equal(vm.runInContext('g_ThirdPersonCameraEnabled',ctx),false,'selecting an infantryman switches to RTS');
+console.log('OK: hero-only TPS, RTS restoration, star visibility, nearby prompt, validated dialogue commands, modal hero controls');
diff --git a/tools/astreval_village_tests/quest_simulation.test.js b/tools/astreval_village_tests/quest_simulation.test.js
new file mode 100644
index 00000000..994ba022
--- /dev/null
+++ b/tools/astreval_village_tests/quest_simulation.test.js
@@ -0,0 +1,197 @@
+/* Offline deterministic API harness for the map script and 0 A.D. commands.
+ * Run with: node tests/quest_simulation.test.js
+ * Not a substitute for a Pyrogenesis rendering/integration test.
+ */
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const base = path.join(__dirname, '..', '..', 'binaries/data/mods/public');
+
+function createWorld() {
+  const entities = new Map();
+  const players = new Map();
+  const diplomacy = [];
+  let nextID = 100, time = 0;
+  for (const id of [1,2,3]) players.set(id, {
+    resources: {wood:300}, CanControlAllUnits() { return false; },
+    GetResourceCounts() { return this.resources; },
+    AddResource(type, amount) { this.resources[type] = (this.resources[type] || 0) + amount; }
+  });
+  function add(owner, cls, name, x, z) {
+    const ent = nextID++;
+    const e = {owner, cls, name, x, z, hp: 300, aiOrders: [], stance: 'aggressive'};
+    entities.set(ent,e);
+    return ent;
+  }
+  const hero = add(1,['Unit','AstrevalHero'],'Gardien',354,306);
+  const elder = add(1,['Unit','AstrevalElder'],'Ancienne',359,312);
+  const guide = add(1,['Unit','AstrevalGuide'],'Guide',346,312);
+  const villager = add(1,['Unit','AstrevalVillager'],'Habitante',365,319);
+  const defender = add(1,['Unit','AstrevalDefender'],'Garde',324,328);
+  const scout = add(1,['Unit','AstrevalScout'],'Éclaireur',379,310);
+  const chief = add(3,['Unit','AstrevalRivalChief'],'Chef',518,431);
+  const idTypes = ['Identity','Position','Ownership','Health','UnitAI'];
+  const iids = Object.fromEntries(idTypes.map(t=>['IID_'+t,t]));
+  Object.assign(iids,{IID_Trigger:'Trigger',IID_Diplomacy:'Diplomacy',IID_Player:'Player',IID_GuiInterface:'GuiInterface'});
+  const ctx = {
+    ...iids, SYSTEM_ENTITY:0, NULL_FORMATION:'special/formations/null',
+    Trigger: function(){}, warn(msg) {throw new Error(msg);}, error(msg) {throw new Error(msg);},
+    QueryPlayerIDInterface(p, iid) {
+      if (iid == 'Player' || !iid) return players.get(p);
+      if (iid == 'Diplomacy') return {
+        SetEnemy(target){diplomacy.push({p,target,enemy:true});},
+        SetNeutral(target){diplomacy.push({p,target,enemy:false});}
+      };
+      return null;
+    },
+    TriggerHelper: {
+      GetEntitiesByPlayer(p){return Array.from(entities).filter(([id,e])=>e.owner==p).map(([id])=>id);},
+      GetOwner(id){return entities.get(id)?.owner ?? -1;},
+      GetTime(){return time;}
+    },
+    Engine: {
+      RegisterGlobal(name, fn){ctx[name]=fn;},
+      QueryInterface(ent,iid){
+        if (ent === 0) return {Trigger:t, GuiInterface:{PushNotification(){}}}[iid] || null;
+        const e=entities.get(ent);
+        if (!e) return null;
+        if (iid=='Identity') return {HasClass(c){return e.cls.includes(c);},GetGenericName(){return e.name;}};
+        if (iid=='Ownership') return {GetOwner(){return e.owner;},SetOwner(p){e.owner=p;}};
+        if (iid=='Position') return {
+          IsInWorld(){return e.hp>0;}, GetPosition2D(){return {x:e.x,y:e.z};},
+          JumpTo(x,z){e.x=x;e.z=z;}
+        };
+        if (iid=='Health') return {GetHitpoints(){return e.hp;}};
+        if (iid=='UnitAI') return {
+          GetStanceName(){return e.stance;},
+          SwitchToStance(s){e.stance=s;},
+          Attack(...args){e.aiOrders.push(['Attack',...args]);},
+          Walk(...args){e.aiOrders.push(['Walk',...args]);},
+          Stop(...args){e.aiOrders.push(['Stop',...args]);},
+          WalkAndFight(...args){e.aiOrders.push(['WalkAndFight',...args]);}
+        };
+        return null;
+      },
+      AddEntity(template) {return add(-1, ['Unit'], template, -1,-1);},
+      DestroyEntity(ent){entities.delete(ent);}
+    },
+    GetFormationUnitAIs(ents){return ents.map(id=>ctx.Engine.QueryInterface(id,'UnitAI'));},
+    FilterEntityList(ents,p) {return ents.filter(ent=>entities.get(ent)?.owner==p);}
+  };
+  const t = new ctx.Trigger();
+  t.RegisterTrigger = (name,action) => assert.equal(typeof t[action], 'function');
+  t.CallEvent = (event, data) => {
+    if (event=='OnPlayerCommand') t.AstrevalPlayerCommand(data);
+  };
+  vm.createContext(ctx);
+  vm.runInContext(fs.readFileSync(path.join(base,'maps/scripts/astreval_village.js'),'utf8'),ctx);
+  vm.runInContext(fs.readFileSync(path.join(base,'simulation/helpers/Commands.js'),'utf8'),ctx);
+  // Replace unrelated formation/selection internals; exercise the real command
+  // dispatch, our validation hooks and the full map trigger instead.
+  ctx.FilterEntityList = (ents,p) => ents.filter(ent=>entities.get(ent)?.owner==p);
+  ctx.GetFormationUnitAIs = ents => ents.map(id=>ctx.Engine.QueryInterface(id,'UnitAI'));
+  t.AstrevalInit();
+  const move=(ent,x,z)=>{entities.get(ent).x=x;entities.get(ent).z=z;};
+  const cmd=(p,type,ent,rest={})=>ctx.ProcessCommand(p,{type,entities:[ent],...rest});
+  return {t, ctx, entities, hero, elder, guide, villager, defender, scout, chief,
+          move,cmd, players, diplomacy, nextTime(n){time+=n;}};
+}
+
+function beginAndDefend(w){
+  const {t,hero,elder,cmd,entities,defender,nextTime} = w;
+  assert.equal(t.astreval.stage,'intro');
+  assert.equal(t.AstrevalGetView(2,hero),null,'private story not exposed to other player');
+  cmd(2,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue,null,'foreign player cannot talk');
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.target,elder);
+  cmd(1,'astreval-choice',hero,{choice:0});
+  assert.equal(t.astreval.stage,'defense');
+  assert.equal(t.astreval.raiders.length,3);
+  assert.equal(t.astreval.dialogue,null);
+  assert(t.astreval.raiders.every(id=>entities.get(id).owner===2));
+  cmd(1,'walk',defender,{x:310,z:305});
+  assert(t.astreval.manualUntil[defender]>0,'RTS command temporarily overrides autonomy');
+  const raid=t.astreval.raiders[0];
+  w.move(raid,defender && 367,333); // attackers approach the village in the native pathfinder
+  cmd(2,'astreval-choice',hero,{choice:0});
+  assert.equal(t.astreval.stage,'defense');
+  nextTime(36000);
+  t.AstrevalTick();
+  assert(entities.get(defender).aiOrders.some(o=>o[0]=='Attack'),'guard engages local raider');
+  t.astreval.raiders.forEach(id=>{entities.get(id).hp=0;});
+  t.AstrevalTick();
+  assert.equal(t.astreval.stage,'scouting');
+  assert.equal(t.astreval.reputation,2);
+  assert(w.diplomacy.some(d=>d.p==1&&d.target==2&&!d.enemy),'enemy restored to neutral after raid');
+}
+
+function scoutingAndReporting(w){
+  const {t,hero,scout,guide,move,cmd,entities,players} = w;
+  const dest=t.astreval.rival;
+  move(scout,dest.x-25,dest.y-15);
+  t.AstrevalTick();
+  assert.equal(t.astreval.stage,'report');
+  move(hero,346,306); // within 9 metres of the guide
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.target,guide);
+  const before=players.get(1).resources.wood;
+  cmd(1,'astreval-choice',hero,{choice:0});
+  assert.equal(t.astreval.stage,'challenge');
+  assert.equal(players.get(1).resources.wood,before+75);
+  cmd(1,'astreval-choice',hero,{choice:0});
+  assert.equal(players.get(1).resources.wood,before+75,'no duplicate reward on stale command');
+}
+
+function duel(){
+  const w=createWorld();
+  beginAndDefend(w); scoutingAndReporting(w);
+  const {t,hero,chief,defender,entities,cmd,move,players}=w;
+  move(hero,514,428);
+  const wood=players.get(1).resources.wood;
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.target,chief);
+  cmd(1,'astreval-choice',hero,{choice:0});
+  assert.equal(t.astreval.stage,'duel');
+  assert.equal(entities.get(chief).stance,'aggressive');
+  const before=entities.get(defender).aiOrders.length;
+  assert.equal(entities.get(defender).stance,'passive');
+  cmd(1,'stance',defender,{name:'aggressive'});
+  assert.equal(entities.get(defender).stance,'passive','duel cannot be broken with an RTS stance change');
+  cmd(1,'attack',defender,{target:chief});
+  cmd(1,'attack-walk',defender,{x:518,z:431});
+  assert.equal(entities.get(defender).aiOrders.length,before,'nonhero attack and attack-move on chief blocked');
+  cmd(1,'attack',hero,{target:chief});
+  assert(entities.get(hero).aiOrders.some(o=>o[0]=='Attack'&&o[1]===chief));
+  entities.get(chief).hp=0;
+  t.AstrevalTick();
+  assert.equal(t.astreval.stage,'peace');
+  assert.equal(players.get(1).resources.wood,wood+180);
+}
+
+function truce(){
+  const w=createWorld();
+  beginAndDefend(w); scoutingAndReporting(w);
+  const {t,hero,chief,villager,cmd,move,players}=w;
+  move(hero,514,428);
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.choices[1].action,'close','truce unavailable without helping residents');
+  cmd(1,'astreval-choice',hero,{choice:1});
+  move(hero,364,315);
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.target,villager);
+  cmd(1,'astreval-choice',hero,{choice:0});
+  assert.equal(t.astreval.reputation,4);
+  move(hero,514,428);
+  cmd(1,'astreval-interact',hero);
+  assert.equal(t.astreval.dialogue.choices[1].action,'truce');
+  cmd(1,'astreval-choice',hero,{choice:1});
+  assert.equal(t.astreval.stage,'peace');
+  assert.equal(t.astreval.duelStarted,false);
+  assert.equal(players.get(1).resources.wood,470);
+}
+
+duel();
+truce();
+console.log('OK: ownership/distance, one-off rewards, raid, manual RTS override, autonomous defense/scouts, report, duel, 1v1 guard and truce');
