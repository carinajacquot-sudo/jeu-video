--- /dev/null
+++ b/binaries/data/mods/public/gui/session/astreval_village_ui.js
@@ -0,0 +1,71 @@
+/* View-only client for the deterministic village story. No quest logic in GUI. */
+class AstrevalVillageUI
+{
+	constructor()
+	{
+		this.view = null;
+		this.dialogueActive = false;
+	}
+
+	update()
+	{
+		const hero = g_CharacterController.getControlledCharacter()?.entity || 0;
+		this.view = Engine.GuiInterfaceCall("GetAstrevalVillageState", { "hero": hero });
+		const journal = Engine.GetGUIObjectByName("astrevalQuestJournal");
+		const prompt = Engine.GetGUIObjectByName("astrevalTalkPrompt");
+		const panel = Engine.GetGUIObjectByName("astrevalDialoguePanel");
+		journal.hidden = !this.view;
+		prompt.hidden = true;
+		panel.hidden = true;
+		this.dialogueActive = false;
+		if (!this.view)
+			return;
+		Engine.GetGUIObjectByName("astrevalQuestCaption").caption =
+			"ASTREVAL  |  Réputation : " + this.view.reputation + "\n" + this.view.quest;
+		if (!hero)
+			return;
+		if (this.view.dialogue)
+		{
+			const dialogue = this.view.dialogue;
+			panel.hidden = false;
+			this.dialogueActive = true;
+			Engine.GetGUIObjectByName("astrevalDialogueText").caption =
+				dialogue.speaker + "\n" + dialogue.text;
+			for (let i = 0; i < 3; ++i)
+			{
+				const button = Engine.GetGUIObjectByName("astrevalChoice" + i);
+				button.hidden = !dialogue.choices[i];
+				if (dialogue.choices[i])
+					button.caption = dialogue.choices[i];
+			}
+		}
+		else if (this.view.nearby)
+		{
+			prompt.hidden = false;
+			prompt.caption = "G  •  Parler à " + this.view.nearby;
+		}
+	}
+
+	interact()
+	{
+		if (this.dialogueActive)
+		{
+			this.choose(-1);
+			return;
+		}
+		const hero = g_CharacterController.getControlledCharacter()?.entity;
+		if (!hero || !this.view?.nearby || g_Disconnected || Engine.IsPaused())
+			return;
+		g_CharacterController.stop();
+		Engine.PostNetworkCommand({ "type": "astreval-interact", "entities": [hero] });
+	}
+
+	choose(choice)
+	{
+		const hero = g_CharacterController.getControlledCharacter()?.entity;
+		if (!hero || !this.dialogueActive || g_Disconnected || Engine.IsPaused() ||
+		    !Number.isInteger(choice) || choice < -1 || choice > 2)
+			return;
+		Engine.PostNetworkCommand({ "type": "astreval-choice", "entities": [hero], "choice": choice });
+	}
+}
