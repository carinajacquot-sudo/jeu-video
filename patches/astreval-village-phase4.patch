-/** Third-person mode for the first selected unit. RTS mode remains available with F. */
+/** Third-person follow belongs exclusively to the Astreval hero. F returns to
+ * the original RTS camera and retains all native troop selection and orders. */
 var g_ThirdPersonCameraEnabled = true;
 
+function refreshAstrevalHeroMarker()
+{
+	if (Engine.GetPlayerID() < 0)
+		return;
+	const hero = (Engine.GuiInterfaceCall("GetPlayerEntities") || []).find(ent => {
+		const state = GetEntityState(ent);
+		return state && hasClass(state, "AstrevalHero");
+	});
+	if (hero)
+		_setHighlight([hero], g_ThirdPersonCameraEnabled ? 0 : 0.65,
