@@ -0,0 +1,519 @@
+/*
+ * Astreval village story. Both scenario maps load this script. All quest state,
+ * autonomy, decisions and combat transitions live in the deterministic simulation;
+ * the GUI only displays a restricted view and submits validated commands.
+ */
+
+Trigger.prototype.AstrevalEntity = function(player, className)
+{
+	for (const ent of TriggerHelper.GetEntitiesByPlayer(player))
+		if (Engine.QueryInterface(ent, IID_Identity)?.HasClass(className))
+			return ent;
+	return 0;
+};
+
+Trigger.prototype.AstrevalPos = function(ent)
+{
+	const cmpPosition = Engine.QueryInterface(ent, IID_Position);
+	return cmpPosition?.IsInWorld() ? cmpPosition.GetPosition2D() : null;
+};
+
+Trigger.prototype.AstrevalDistance = function(a, b)
+{
+	const posA = this.AstrevalPos(a);
+	const posB = this.AstrevalPos(b);
+	return posA && posB ? Math.hypot(posA.x - posB.x, posA.y - posB.y) : Infinity;
+};
+
+Trigger.prototype.AstrevalAlive = function(ent)
+{
+	const cmpHealth = Engine.QueryInterface(ent, IID_Health);
+	return !!cmpHealth && cmpHealth.GetHitpoints() > 0 && !!this.AstrevalPos(ent);
+};
+
+Trigger.prototype.AstrevalSetDiplomacy = function(a, b, enemy)
+{
+	const cmpA = QueryPlayerIDInterface(a, IID_Diplomacy);
+	const cmpB = QueryPlayerIDInterface(b, IID_Diplomacy);
+	if (!cmpA || !cmpB)
+		return;
+	if (enemy)
+	{
+		cmpA.SetEnemy(b);
+		cmpB.SetEnemy(a);
+	}
+	else
+	{
+		cmpA.SetNeutral(b);
+		cmpB.SetNeutral(a);
+	}
+};
+
+Trigger.prototype.AstrevalInit = function()
+{
+	const hero = this.AstrevalEntity(1, "AstrevalHero");
+	const elder = this.AstrevalEntity(1, "AstrevalElder");
+	const guide = this.AstrevalEntity(1, "AstrevalGuide");
+	const chief = this.AstrevalEntity(3, "AstrevalRivalChief");
+	if (!hero || !elder || !guide || !chief)
+	{
+		warn("Astreval village: missing hero, elder, guide or rival chief");
+		return;
+	}
+
+	this.astreval = {
+		"hero": hero, "elder": elder, "guide": guide, "chief": chief,
+		"home": this.AstrevalPos(elder), "rival": this.AstrevalPos(chief),
+		"stage": "intro", "reputation": 0, "villagersHelped": {},
+		"raiders": [], "dialogue": null, "manualUntil": {},
+		"orders": {}, "roles": {}, "scoutWaypoints": {}, "scoutReached": false,
+		"defenseHelp": false, "duelStarted": false, "duelStances": {}
+	};
+
+	// Story battles are opt-in: the other village and its chief do not wage an
+	// unrelated RTS conquest war before the player has spoken with the elder.
+	this.AstrevalSetDiplomacy(1, 2, false);
+	this.AstrevalSetDiplomacy(1, 3, false);
+	this.AstrevalSetDiplomacy(2, 3, false);
+	this.RegisterTrigger("OnInterval", "AstrevalTick", { "enabled": true, "interval": 2000, "delay": 2000 });
+	this.RegisterTrigger("OnPlayerCommand", "AstrevalPlayerCommand", { "enabled": true });
+	for (const ent of TriggerHelper.GetEntitiesByPlayer(1))
+	{
+		const cmpIdentity = Engine.QueryInterface(ent, IID_Identity);
+		const cmpAI = Engine.QueryInterface(ent, IID_UnitAI);
+		if (!cmpIdentity || !cmpAI)
+			continue;
+		if (cmpIdentity.HasClass("AstrevalDefender") || cmpIdentity.HasClass("AstrevalAdventurer"))
+			cmpAI.SwitchToStance("defensive");
+		if (cmpIdentity.HasClass("AstrevalScout"))
+			cmpAI.SwitchToStance("passive");
+	}
+	// Do not auto-attack an approaching player in the rival village before the duel.
+	Engine.QueryInterface(chief, IID_UnitAI)?.SwitchToStance("passive");
+};
+
+/** Explicit RTS orders take precedence for 35 seconds; autonomous roles resume. */
+Trigger.prototype.AstrevalPlayerCommand = function(msg)
+{
+	if (!this.astreval || msg.player != 1 || !msg.cmd?.entities ||
+	    !["walk", "walk-custom", "attack", "attack-walk", "attack-walk-custom",
+	      "patrol", "guard", "stop", "stance", "formation"].includes(msg.cmd.type))
+		return;
+	const now = TriggerHelper.GetTime();
+	for (const ent of msg.cmd.entities)
+	{
+		if (TriggerHelper.GetOwner(ent) != 1)
+			continue;
+		const identity = Engine.QueryInterface(ent, IID_Identity);
+		if (identity && (identity.HasClass("AstrevalDefender") ||
+		    identity.HasClass("AstrevalScout") || identity.HasClass("AstrevalAdventurer")))
+			this.astreval.manualUntil[ent] = now + 35000;
+	}
+};
+
+Trigger.prototype.AstrevalSpawn = function(template, owner, x, z)
+{
+	const ent = Engine.AddEntity(template);
+	const cmpOwner = Engine.QueryInterface(ent, IID_Ownership);
+	const cmpPosition = Engine.QueryInterface(ent, IID_Position);
+	if (!cmpOwner || !cmpPosition)
+	{
+		Engine.DestroyEntity(ent);
+		return 0;
+	}
+	cmpOwner.SetOwner(owner);
+	cmpPosition.JumpTo(x, z);
+	return ent;
+};
+
+Trigger.prototype.AstrevalStartRaid = function()
+{
+	const s = this.astreval;
+	const dx = s.rival.x - s.home.x;
+	const dz = s.rival.y - s.home.y;
+	const length = Math.hypot(dx, dz) || 1;
+	const x = s.home.x + 86 * dx / length;
+	const z = s.home.y + 86 * dz / length;
+	this.AstrevalSetDiplomacy(1, 2, true);
+	for (let i = 0; i < 3; ++i)
+	{
+		const ent = this.AstrevalSpawn("units/gaul/infantry_spearman_b", 2,
+			x + i * 3 - 3, z + i * 4 - 4);
+		if (!ent)
+			continue;
+		s.raiders.push(ent);
+		Engine.QueryInterface(ent, IID_UnitAI)?.WalkAndFight(s.home.x, s.home.y,
+			undefined, false, false, false);
+	}
+	if (!s.raiders.length)
+		warn("Astreval village: raid could not be spawned");
+};
+
+Trigger.prototype.AstrevalScoutTick = function(ent, now)
+{
+	const s = this.astreval;
+	const pos = this.AstrevalPos(ent);
+	if (!pos)
+		return;
+	const dx = s.rival.x - s.home.x;
+	const dz = s.rival.y - s.home.y;
+	const length = Math.hypot(dx, dz) || 1;
+	const route = s.scoutReached ? [s.home] :
+		[0.30, 0.60, 0.88].map(t => ({ "x": s.home.x + dx * t, "y": s.home.y + dz * t }));
+	let waypoint = s.scoutWaypoints[ent] || 0;
+	if (!s.scoutReached && (Math.hypot(pos.x - s.rival.x, pos.y - s.rival.y) < 85 || waypoint >= route.length))
+	{
+		s.scoutReached = true;
+		s.stage = "report";
+		s.scoutWaypoints = {};
+		waypoint = 0;
+	}
+	const points = s.scoutReached ? [s.home] : route;
+	const target = points[Math.min(waypoint, points.length - 1)];
+	if (Math.hypot(pos.x - target.x, pos.y - target.y) < 11 && !s.scoutReached)
+	{
+		waypoint = Math.min(waypoint + 1, points.length);
+		s.scoutWaypoints[ent] = waypoint;
+	}
+	if (waypoint >= points.length && !s.scoutReached)
+		return;
+	const next = points[Math.min(waypoint, points.length - 1)];
+	if (Math.hypot(pos.x - next.x, pos.y - next.y) < 9)
+		return;
+	const order = s.orders[ent];
+	if (!order || order.waypoint != waypoint || now - order.time > 24000)
+	{
+		Engine.QueryInterface(ent, IID_UnitAI)?.Walk(next.x, next.y, false, false);
+		s.orders[ent] = { "waypoint": waypoint, "time": now };
+	}
+};
+
+Trigger.prototype.AstrevalEndDuel = function()
+{
+	const s = this.astreval;
+	this.AstrevalSetDiplomacy(1, 3, false);
+	Engine.QueryInterface(s.chief, IID_UnitAI)?.SwitchToStance("passive");
+	for (const ent in s.duelStances)
+	{
+		if (TriggerHelper.GetOwner(+ent) == 1)
+			Engine.QueryInterface(+ent, IID_UnitAI)?.SwitchToStance(s.duelStances[ent]);
+	}
+	s.roles = {};
+	s.duelStances = {};
+};
+
+Trigger.prototype.AstrevalTick = function()
+{
+	const s = this.astreval;
+	if (!s)
+		return;
+	const now = TriggerHelper.GetTime();
+	if (s.stage == "defense" && s.raiders.length && s.raiders.every(ent => !this.AstrevalAlive(ent)))
+	{
+		this.AstrevalSetDiplomacy(1, 2, false);
+		s.stage = "scouting";
+		s.reputation++;
+	}
+	if (s.stage == "duel")
+	{
+		if (!this.AstrevalAlive(s.hero))
+		{
+			s.stage = "defeat";
+			this.AstrevalEndDuel();
+		}
+		else if (!this.AstrevalAlive(s.chief))
+		{
+			s.stage = "peace";
+			s.reputation += 2;
+			QueryPlayerIDInterface(1, IID_Player)?.AddResource("wood", 180);
+			this.AstrevalEndDuel();
+		}
+	}
+
+	for (const ent of TriggerHelper.GetEntitiesByPlayer(1))
+	{
+		const identity = Engine.QueryInterface(ent, IID_Identity);
+		const ai = Engine.QueryInterface(ent, IID_UnitAI);
+		if (!identity || !ai)
+			continue;
+		const defender = identity.HasClass("AstrevalDefender");
+		const adventurer = identity.HasClass("AstrevalAdventurer");
+		const scout = identity.HasClass("AstrevalScout");
+		if (!defender && !adventurer && !scout)
+			continue;
+		// A player-directed scout can still discover the rival camp; explicit
+		// movement orders suppress AI routing, not quest observation.
+		if (scout && s.stage == "scouting" && this.AstrevalDistance(ent, s.chief) < 85)
+		{
+			s.scoutReached = true;
+			s.stage = "report";
+			s.scoutWaypoints = {};
+		}
+		// Preserve native player RTS orders (including stance) for 35s.
+		// The duel is the exception: every nonhero must remain passive.
+		if (s.manualUntil[ent] > now && s.stage != "duel")
+			continue;
+		const stance = s.stage == "duel" || scout ? "passive" : "defensive";
+		if (s.roles[ent] != stance)
+		{
+			ai.SwitchToStance(stance);
+			s.roles[ent] = stance;
+		}
+		if (s.manualUntil[ent] > now)
+			continue;
+		if (scout && (s.stage == "scouting" || s.stage == "report"))
+		{
+			this.AstrevalScoutTick(ent, now);
+			continue;
+		}
+		if (s.stage == "duel" && this.AstrevalDistance(ent, s.chief) < 34)
+		{
+			// Preserve a genuine hero/chief one-on-one even when the squad was
+			// previously near the rival village.
+			ai.Walk(s.home.x, s.home.y, false, false);
+			continue;
+		}
+		if (!defender && !adventurer)
+			continue;
+		const pos = this.AstrevalPos(ent);
+		if (!pos)
+			continue;
+		if (s.stage == "defense")
+		{
+			const nearby = s.raiders.filter(raider => this.AstrevalAlive(raider) &&
+				this.AstrevalDistance(ent, raider) < (adventurer ? 110 : 82));
+			if (nearby.length)
+			{
+				const target = nearby[0];
+				if (s.orders[ent]?.target != target || now - s.orders[ent].time > 12500)
+				{
+					ai.Attack(target, false, false, false);
+					s.orders[ent] = { "target": target, "time": now };
+				}
+				continue;
+			}
+		}
+		// Keep the village protected instead of following the hero across the
+		// map. Individual posts are stable and manual RTS orders have priority.
+		const postX = s.home.x + (ent % 5 - 2) * 8;
+		const postZ = s.home.y + (ent % 3 - 1) * 9;
+		if (Math.hypot(pos.x - postX, pos.y - postZ) > 26 &&
+		    (!s.orders[ent]?.post || now - s.orders[ent].time > 18000))
+		{
+			ai.Walk(postX, postZ, false, false);
+			s.orders[ent] = { "post": true, "time": now };
+		}
+	}
+};
+
+Trigger.prototype.AstrevalQuestText = function()
+{
+	const s = this.astreval;
+	if (!s)
+		return "";
+	return ({
+		"intro": "Parler \u00e0 l'ancienne du village (G pr\u00e8s d'elle).",
+		"defense": "D\u00e9fendre Astreval : repousser les trois pillards.",
+		"scouting": "Les \u00e9claireurs reconnaissent le village rival.",
+		"report": "Retrouver le guide pour entendre son rapport.",
+		"challenge": "Rencontrer le chef rival : duel ou tr\u00eave.",
+		"duel": "Duel 1 contre 1 : vaincre le chef rival avec le h\u00e9ros.",
+		"peace": "Paix conclue. Le village est sauv\u00e9.",
+		"defeat": "Le h\u00e9ros est tomb\u00e9. Le duel est perdu."
+	})[s.stage] || "";
+};
+
+Trigger.prototype.AstrevalNear = function(hero)
+{
+	const s = this.astreval;
+	if (!s || !this.AstrevalAlive(hero))
+		return 0;
+	let nearest = 0;
+	let best = 9;
+	for (const player of [1, 3])
+		for (const ent of TriggerHelper.GetEntitiesByPlayer(player))
+		{
+			if (ent == hero)
+				continue;
+			const identity = Engine.QueryInterface(ent, IID_Identity);
+			if (!identity || !["AstrevalElder", "AstrevalGuide", "AstrevalVillager",
+				"AstrevalRivalChief"].some(type => identity.HasClass(type)))
+				continue;
+			const distance = this.AstrevalDistance(hero, ent);
+			if (distance >= best)
+				continue;
+			nearest = ent;
+			best = distance;
+		}
+	return nearest;
+};
+
+Trigger.prototype.AstrevalGetDialogue = function(ent)
+{
+	const s = this.astreval;
+	const identity = Engine.QueryInterface(ent, IID_Identity);
+	if (!identity)
+		return null;
+	const options = (text, choices) => ({
+		"speaker": identity.GetGenericName(), "text": text,
+		"target": ent, "choices": choices.map(([label, action]) => ({ "label": label, "action": action }))
+	});
+	if (identity.HasClass("AstrevalElder"))
+	{
+		if (s.stage == "intro")
+			return options("Des pillards convoitent nos maisons. Les gardes tiennent la porte, mais nous avons besoin de votre aide.",
+				[["Prot\u00e9ger le village", "start"], ["J'\u00e9couterai plus tard", "close"]]);
+		if (s.stage == "defense" && !s.defenseHelp)
+			return options("Nous pouvons appeler deux aventuriers pour renforcer la d\u00e9fense, au prix de notre r\u00e9serve de bois.",
+				[["Appeler des renforts (-50 bois)", "reinforce"], ["Garder nos r\u00e9serves", "close"]]);
+		return options("Notre survie d\u00e9pend de vos d\u00e9cisions. " + this.AstrevalQuestText(), [["Je comprends", "close"]]);
+	}
+	if (identity.HasClass("AstrevalGuide"))
+	{
+		if (s.stage == "report")
+			return options("Le chef rival campe au-del\u00e0 des sentinelles. Mon rapport peut ouvrir un dialogue au lieu d'une guerre.",
+				[["Recevoir le rapport et partager la carte", "report"], ["Plus tard", "close"]]);
+		return options(s.stage == "scouting" ?
+			"Nos \u00e9claireurs progressent seuls; donnez-leur aussi des ordres en vue RTS si n\u00e9cessaire." :
+			"Les sentinelles patrouillent; le village reste \u00e0 l'\u00e9coute de votre d\u00e9cision.",
+			[["Merci", "close"]]);
+	}
+	if (identity.HasClass("AstrevalRivalChief"))
+	{
+		if (s.stage == "challenge")
+		{
+			const choices = [["Un duel \u00e0 l'\u00e9p\u00e9e, sans soldats", "duel"]];
+			if (s.reputation >= 4)
+				choices.push(["Proposer une tr\u00eave (r\u00e9putation 4)", "truce"]);
+			choices.push(["Revenir plus tard", "close"]);
+			return options("Vous avez d\u00e9fendu vos gens. Nous d\u00e9ciderons ici, face \u00e0 face, du sort des deux villages.", choices);
+		}
+		return options(s.stage == "peace" ? "La paix est scell\u00e9e. Que nos villages prosp\u00e8rent." :
+			"Revenez avec le rapport des \u00e9claireurs et une proposition honorable.", [["Partir", "close"]]);
+	}
+	if (identity.HasClass("AstrevalVillager"))
+		return options(s.villagersHelped[ent] ?
+			"Les remparts tiendront. Merci pour votre visite." :
+			"Les habitants r\u00e9parent les maisons. Un coup de main nous rendrait courage.",
+			s.villagersHelped[ent] ? [["Au revoir", "close"]] :
+			[["Aider les habitants (+r\u00e9putation)", "help"], ["Pas maintenant", "close"]]);
+	return null;
+};
+
+/** Client messages carry only a hero ID; the simulation chooses the nearby NPC. */
+Trigger.prototype.AstrevalInteract = function(player, hero)
+{
+	const s = this.astreval;
+	if (!s || player != 1 || hero != s.hero || TriggerHelper.GetOwner(hero) != player ||
+	    !Engine.QueryInterface(hero, IID_Identity)?.HasClass("AstrevalHero"))
+		return;
+	const ent = this.AstrevalNear(hero);
+	if (ent)
+		s.dialogue = this.AstrevalGetDialogue(ent);
+};
+
+Trigger.prototype.AstrevalChoose = function(player, hero, choice)
+{
+	const s = this.astreval;
+	if (!s || player != 1 || hero != s.hero || TriggerHelper.GetOwner(hero) != player ||
+	    !s.dialogue || !Number.isInteger(choice) || choice < -1 || choice > 2)
+		return;
+	if (choice == -1)
+	{
+		s.dialogue = null;
+		return;
+	}
+	const dialogue = s.dialogue;
+	if (!this.AstrevalAlive(hero) || this.AstrevalDistance(hero, dialogue.target) >= 11 ||
+	    !dialogue.choices[choice])
+	{
+		s.dialogue = null;
+		return;
+	}
+	const action = dialogue.choices[choice].action;
+	// A stale network command cannot be used to repeat a quest reward.
+	if (action == "start" && s.stage == "intro")
+	{
+		s.stage = "defense";
+		s.reputation++;
+		this.AstrevalStartRaid();
+	}
+	else if (action == "reinforce" && s.stage == "defense" && !s.defenseHelp)
+	{
+		const cmpPlayer = QueryPlayerIDInterface(1, IID_Player);
+		if (cmpPlayer && cmpPlayer.GetResourceCounts().wood >= 50)
+		{
+			cmpPlayer.AddResource("wood", -50);
+			s.defenseHelp = true;
+			for (let i = 0; i < 2; ++i)
+				this.AstrevalSpawn("units/spart/astreval_adventurer", 1,
+					s.home.x - 10 - i * 3, s.home.y + 14);
+		}
+	}
+	else if (action == "help" &&
+	    Engine.QueryInterface(dialogue.target, IID_Identity)?.HasClass("AstrevalVillager") &&
+	    !s.villagersHelped[dialogue.target])
+	{
+		s.villagersHelped[dialogue.target] = true;
+		s.reputation++;
+		QueryPlayerIDInterface(1, IID_Player)?.AddResource("wood", 15);
+	}
+	else if (action == "report" && s.stage == "report" && dialogue.target == s.guide)
+	{
+		s.stage = "challenge";
+		s.reputation++;
+		QueryPlayerIDInterface(1, IID_Player)?.AddResource("wood", 75);
+	}
+	else if (action == "duel" && s.stage == "challenge" && dialogue.target == s.chief)
+	{
+		s.stage = "duel";
+		s.duelStarted = true;
+		// Disable allied auto-attacks before declaring the two duelists hostile.
+		// This applies to vanilla troops too, not only our three custom roles.
+		for (const ent of TriggerHelper.GetEntitiesByPlayer(1))
+		{
+			if (ent == s.hero)
+				continue;
+			const ai = Engine.QueryInterface(ent, IID_UnitAI);
+			if (!ai)
+				continue;
+			s.duelStances[ent] = ai.GetStanceName();
+			ai.SwitchToStance("passive");
+			ai.Stop(false, false);
+			if (this.AstrevalDistance(ent, s.chief) < 35)
+				ai.Walk(s.home.x, s.home.y, false, false);
+			s.roles[ent] = "passive";
+		}
+		this.AstrevalSetDiplomacy(1, 3, true);
+		Engine.QueryInterface(s.chief, IID_UnitAI)?.SwitchToStance("aggressive");
+		Engine.QueryInterface(s.chief, IID_UnitAI)?.Attack(s.hero, false, false, false);
+	}
+	else if (action == "truce" && s.stage == "challenge" && s.reputation >= 4 && dialogue.target == s.chief)
+	{
+		s.stage = "peace";
+		QueryPlayerIDInterface(1, IID_Player)?.AddResource("wood", 80);
+		this.AstrevalSetDiplomacy(1, 3, false);
+	}
+	s.dialogue = null;
+};
+
+/** Return only player 1's quest, the controlled hero's nearby NPC and its dialogue. */
+Trigger.prototype.AstrevalGetView = function(player, hero)
+{
+	const s = this.astreval;
+	if (!s || player != 1)
+		return null;
+	const validHero = hero == s.hero && TriggerHelper.GetOwner(hero) == player && this.AstrevalAlive(hero);
+	const nearby = validHero && this.AstrevalNear(hero);
+	return {
+		"quest": this.AstrevalQuestText(), "stage": s.stage, "reputation": s.reputation,
+		"nearby": nearby ? Engine.QueryInterface(nearby, IID_Identity)?.GetGenericName() : "",
+		"dialogue": validHero && s.dialogue ? {
+			"speaker": s.dialogue.speaker, "text": s.dialogue.text,
+			"choices": s.dialogue.choices.map(({ label }) => label)
+		} : null
+	};
+};
+
+const cmpAstrevalVillageTrigger = Engine.QueryInterface(SYSTEM_ENTITY, IID_Trigger);
+cmpAstrevalVillageTrigger.RegisterTrigger("OnInitGame", "AstrevalInit", { "enabled": true });
