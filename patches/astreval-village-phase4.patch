+		const state = selected && GetEntityState(selected);
+		if (!state || !hasClass(state, "AstrevalHero"))
+		{
+			selectCharacter();
+			return;
+		}
+		g_ThirdPersonCameraEnabled = true;
 		updateThirdPersonCamera();
+	}
 	else
 	{
+		g_ThirdPersonCameraEnabled = false;
 		g_CharacterController.stop();
 		Engine.CameraFollowThirdPerson(0);
+		refreshAstrevalHeroMarker();
 	}
 }
