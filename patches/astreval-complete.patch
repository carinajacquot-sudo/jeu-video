diff --git a/tools/build_astreval_greatsword.py b/tools/build_astreval_greatsword.py
new file mode 100644
index 00000000..c0659fe9
--- /dev/null
+++ b/tools/build_astreval_greatsword.py
@@ -0,0 +1,146 @@
+"""Build Astreval's original, back-mounted 3D greatsword for 0 A.D.
+
+Run with Blender 3.6 LTS (COLLADA exporter):
+  blender -b -noaudio --python tools/build_astreval_greatsword.py -- /path/to/0ad
+The sword geometry and palette are original; the surrounding character uses
+0 A.D.'s native biped, armor, animations and long black cape.
+"""
+import bpy
+import math
+import random
+import struct
+import sys
+import zlib
+from pathlib import Path
+from mathutils import Matrix, Vector
+
+args = sys.argv[sys.argv.index('--') + 1:]
+root = Path(args[0]).resolve()
+art = root / 'binaries/data/mods/public/art'
+mesh_path = art / 'meshes/props/astreval/greatsword_back.dae'
+texture_path = art / 'textures/skins/props/astreval/greatsword_palette.png'
+mesh_path.parent.mkdir(parents=True, exist_ok=True)
+texture_path.parent.mkdir(parents=True, exist_ok=True)
+bpy.ops.wm.read_factory_settings(use_empty=True)
+
+# Tiles in the tiny texture atlas, in bottom-to-top UV order. A restrained
+# steel/black/antique gold palette matches 0 A.D. instead of a neon fantasy toy.
+colors = (
+    ((129, 145, 150), (178, 194, 193), (215, 224, 215), (72, 80, 81)),
+    ((163, 133, 78), (112, 88, 52), (34, 36, 38), (53, 62, 71)),
+    ((31, 89, 122), (83, 145, 162), (45, 35, 32), (178, 111, 64)),
+    ((103, 115, 115), (46, 56, 62), (202, 174, 108), (23, 28, 31))
+)
+random.seed(21)
+pixels = bytearray()
+for y in range(255, -1, -1):
+    pixels.append(0)  # PNG filter: none
+    for x in range(256):
+        r, g, b = colors[y // 64][x // 64]
+        grain = random.randrange(-5, 6)
+        pixels.extend((max(0, min(255, r + grain)),
+                       max(0, min(255, g + grain)),
+                       max(0, min(255, b + grain))))
+
+def chunk(kind, payload):
+    return struct.pack('>I', len(payload)) + kind + payload + struct.pack('>I', zlib.crc32(kind + payload))
+
+texture_path.write_bytes(
+    b'\x89PNG\r\n\x1a\n' +
+    chunk(b'IHDR', struct.pack('>IIBBBBB', 256, 256, 8, 2, 0, 0, 0)) +
+    chunk(b'IDAT', zlib.compress(bytes(pixels), 9)) + chunk(b'IEND', b''))
+
+vertices, faces, tiles = [], [], []
+def add(coords, polygons, palette):
+    base = len(vertices)
+    vertices.extend(coords)
+    faces.extend(tuple(base + i for i in face) for face in polygons)
+    tiles.extend([palette] * len(polygons))
+
+
+def cuboid(x0, x1, y0, y1, z0, z1, palette, edge=None):
+    v = [(x0,y0,z0), (x1,y0,z0), (x1,y1,z0), (x0,y1,z0),
+         (x0,y0,z1), (x1,y0,z1), (x1,y1,z1), (x0,y1,z1)]
+    quads = [(3,2,1,0), (4,5,6,7), (0,1,5,4), (1,2,6,5),
+             (2,3,7,6), (3,0,4,7)]
+    for index, poly in enumerate(quads):
+        add(v, [poly], edge if edge is not None and index in (1,3) else palette)
+
+
+def band(z0, z1, radius, palette, n=10):
+    v=[]
+    for z in (z0,z1):
+        for i in range(n):
+            a=math.tau*i/n
+            v.append((radius*math.cos(a), radius*math.sin(a), z))
+    side=[(i,(i+1)%n,(i+1)%n+n,i+n) for i in range(n)]
+    side += [tuple(reversed(tuple(range(n)))), tuple(range(n,2*n))]
+    add(v,side,palette)
+
+# The blade has a convex diamond cross-section and a sharp tapered tip.
+sections=[(0.76,0.235,0.095),(0.62,0.225,0.087),(-0.25,0.190,0.071),
+          (-0.96,0.145,0.058),(-1.38,0.075,0.037)]
+ring=[]
+for z,width,depth in sections:
+    base=len(vertices)
+    vertices.extend(((-width,0,z),(0,-depth,z),(width,0,z),(0,depth,z)))
+    ring.append(base)
+for before,after in zip(ring,ring[1:]):
+    for side in range(4):
+        faces.append((before+side,before+(side+1)%4,after+(side+1)%4,after+side))
+        tiles.append((0, 1 if side in (2,3) else 0))
+tip=len(vertices);vertices.append((0,0,-1.59))
+for side in range(4):
+    faces.append((ring[-1]+side,ring[-1]+(side+1)%4,tip))
+    tiles.append((2,0))
+
+# Long narrow steel fuller and dark back scabbard fittings give the silhouette
+# of an enormous sword visible over the animated black cape.
+cuboid(-0.018,0.018,0.095,0.111,-0.76,0.58,(3,0))
+# Crossguard: swept dark iron bar, gold tips and a sapphire on the outer face.
+cuboid(-0.47,0.47,-0.12,0.12,0.74,0.88,(3,1),edge=(0,2))
+for side in (-1,1):
+    x=side*0.47
+    cuboid(min(x, x+side*0.065),max(x,x+side*0.065),-0.135,0.135,0.69,0.96,(0,1),edge=(2,3))
+cuboid(-0.075,0.075,0.12,0.17,0.71,0.88,(0,2))
+cuboid(-0.041,0.041,0.174,0.20,0.75,0.845,(0,2))
+# Leather two-hand grip with brass wrappings and a broad faceted pommel.
+band(0.85,1.46,0.075,(2,1))
+for z in (0.90,1.03,1.16,1.29,1.42):
+    band(z,z+0.028,0.083,(0,1))
+band(1.45,1.58,0.130,(2,3))
+band(1.58,1.64,0.080,(0,1))
+
+# Root attachment uses the same coordinate system as the stock 0 A.D. cape.
+# +Y is the back of the character in its Blender Z-up source coordinates.
+# The pommel sits above the right shoulder; the long blade crosses the cape.
+rotation = Matrix.Rotation(math.radians(23), 4, 'Y')
+offset = Vector((0.02, 0.72, 2.28))
+vertices = [tuple(rotation @ Vector(v) + offset) for v in vertices]
+mesh = bpy.data.meshes.new('greatsword_back_geometry')
+mesh.from_pydata(vertices, [], faces)
+mesh.update()
+obj = bpy.data.objects.new('greatsword_back', mesh)
+bpy.context.collection.objects.link(obj)
+uv = mesh.uv_layers.new(name='UVMap')
+for face, tile in zip(mesh.polygons, tiles):
+    u, v = ((tile[0]+0.5)/4, (tile[1]+0.5)/4)
+    for loop in face.loop_indices:
+        uv.data[loop].uv = (u, v)
+material = bpy.data.materials.new('Greatsword palette')
+material.use_nodes = True
+image = bpy.data.images.load(str(texture_path))
+node = material.node_tree.nodes.new('ShaderNodeTexImage')
+node.image = image
+material.node_tree.links.new(node.outputs['Color'], material.node_tree.nodes.get('Principled BSDF').inputs['Base Color'])
+obj.data.materials.append(material)
+
+bpy.ops.object.select_all(action='DESELECT')
+obj.select_set(True)
+bpy.context.view_layer.objects.active = obj
+print('VERTICES',len(mesh.vertices),'FACES',len(mesh.polygons),'BOUNDS',
+      [tuple(round(x,3) for x in obj.bound_box[i]) for i in (0,6)])
+result=bpy.ops.wm.collada_export(filepath=str(mesh_path),selected=True,
+    include_animations=False,include_all_actions=False,triangulate=True,
+    use_texture_copies=False,apply_modifiers=True)
+print('SWORD',result,str(mesh_path),mesh_path.stat().st_size,'TEXTURE',texture_path.stat().st_size)
