+"""Create a 0 A.D. landscape showcase by placing the Astreval hero in Arcadia.
+
+Run inside the native 0 A.D. repository: python3 tools/make_astreval_arcadia.py
+The original Arcadia map is never edited. Its terrain, vegetation and base
+layout remain under their existing 0 A.D. asset licence; this is a derivative
+scenario and not a new terrain authored from scratch.
+"""
+import re
+import shutil
+from pathlib import Path
+
+root=Path(__file__).resolve().parents[1]
+scenarios=root/'binaries/data/mods/public/maps/scenarios'
+src=scenarios/'arcadia.xml'
+dst=scenarios/'astreval_arcadia.xml'
+text=src.read_text(encoding='utf-8')
+marker='''\t\t<Entity uid="4756">
+\t\t\t<Template>units/spart/infantry_spearman_e</Template>
+\t\t\t<Player>1</Player>
+\t\t\t<Position x="616.63794" z="614.44721"/>
+\t\t\t<Orientation y="2.35621"/>'''
+assert text.count(marker)==1
+new_hero=marker.replace('units/spart/infantry_spearman_e','units/athen/hero_astreval')
+# Place the protagonist beside the army, not inside the group of villagers;
+# the TPS camera then sees the human, sword and cape without foreground NPCs.
+new_hero=new_hero.replace('616.63794','665').replace('614.44721','605').replace('2.35621','0')
+text=text.replace(marker,new_hero)
+name='"Name": "Arcadia",'
+assert text.count(name)==1
+text=text.replace(name,'"Name": "Astreval — Gardien noir d’Arcadie",')
+text,n=re.subn(r'(?m)^  "Description": ".*",$',
+    '  "Description": "Le gardien humain d’Astreval traverse Arcadie avec une cape noire et une grande épée dans le dos. F4 : choisir le héros ; F : caméra TPS/RTS ; ZQSD/WASD : avancer ; Maj : courir.",',
+    text,count=1)
+assert n==1
+# Original camera and victory setup remain native. The 0 A.D. map owns the
+# nature, villages and both playable armies; one friendly model/position changes.
+dst.write_text(text,encoding='utf-8')
+shutil.copyfile(scenarios/'arcadia.pmp', scenarios/'astreval_arcadia.pmp')
+print('Created',dst,'and Arcadia terrain copy; one player-1 unit became the Astreval hero.')
