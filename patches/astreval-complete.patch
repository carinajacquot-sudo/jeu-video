diff --git a/binaries/data/mods/public/gui/session/character_controller.js b/binaries/data/mods/public/gui/session/character_controller.js
new file mode 100644
index 00000000..f105a47a
--- /dev/null
+++ b/binaries/data/mods/public/gui/session/character_controller.js
@@ -0,0 +1,186 @@
+/*
+ * Client-side avatar controls. The simulation still owns movement/collision:
+ * we send short validated orders, not per-frame position updates or teleports.
+ */
+class CharacterController
+{
+	constructor()
+	{
+		this.keys = { "forward": false, "back": false, "left": false, "right": false, "run": false };
+		this.entity = 0;
+		this.moving = false;
+		this.lastAxes = "";
+		this.lastRun = false;
+		this.lastTarget = null;
+		this.lastSent = 0;
+		this.heading = 0;
+	}
+
+	setKey(key, pressed)
+	{
+		if (!(key in this.keys))
+			return;
+		this.keys[key] = pressed;
+
+		// Release must stop immediately, including if the next GUI tick is delayed.
+		if (!pressed && key != "run" && !this.keys.forward && !this.keys.back &&
+		    !this.keys.left && !this.keys.right)
+			this.stop();
+	}
+
+	keyDown(key)
+	{
+		if (this.keys[key] && !Engine.HotkeyIsPressed("character." + key))
+			this.keys[key] = false; // GUI focus may consume the key-release event.
+		return this.keys[key];
+	}
+
+	getControlledCharacter()
+	{
+		if (!g_ThirdPersonCameraEnabled || g_Selection.size() != 1 || Engine.GetPlayerID() < 0)
+			return null;
+
+		const entity = g_Selection.getFirstSelected();
+		const state = entity && GetEntityState(entity);
+		if (!state || !state.position || !state.unitAI || !state.identity ||
+		    !state.identity.controllable || !hasClass(state, "Unit") ||
+		    !Number.isFinite(state.rotationY) || !controlsPlayer(state.player))
+			return null;
+
+		return { "entity": entity, "state": state };
+	}
+
+	updateHint(visible)
+	{
+		const hint = Engine.GetGUIObjectByName("characterControlHint");
+		hint.hidden = !visible;
+		if (visible)
+			hint.caption = translate("PERSONNAGE | Z/W avancer | Q/A gauche | S reculer | D droite | Maj courir | F RTS | F4 héros");
+	}
+
+	stop()
+	{
+		if (this.moving && this.entity && !g_Disconnected)
+			Engine.PostNetworkCommand({ "type": "stop", "entities": [this.entity], "queued": false });
+		this.moving = false;
+		this.lastAxes = "";
+		this.lastTarget = null;
+		this.lastRun = false;
+	}
+
+	onSelectionChanged()
+	{
+		this.stop();
+		this.entity = 0;
+		this.updateHint(false);
+	}
+
+	update()
+	{
+		const character = this.getControlledCharacter();
+		if (!character || g_Disconnected)
+		{
+			this.onSelectionChanged();
+			return;
+		}
+
+		if (this.entity != character.entity)
+		{
+			this.stop();
+			this.entity = character.entity;
+			this.updateHint(true);
+		}
+
+		// A camera interrupted by another GUI action is reattached to the avatar.
+		if (Engine.GetFollowedEntity() != this.entity)
+			Engine.CameraFollowThirdPerson(this.entity);
+
+		if (Engine.IsPaused() || GetSimState().cinemaPlaying)
+		{
+			this.stop();
+			return;
+		}
+
+		const forward = this.keyDown("forward") ? 1 : 0;
+		const back = this.keyDown("back") ? 1 : 0;
+		const left = this.keyDown("left") ? 1 : 0;
+		const right = this.keyDown("right") ? 1 : 0;
+		const run = this.keyDown("run");
+		const x = right - left;
+		const z = forward - back;
+		if (!x && !z)
+		{
+			this.stop();
+			return;
+		}
+
+		// Sample the character's facing ONCE per change of keys: recomputing
+		// left/right from the new facing every frame would make it spiral.
+		const axes = x + ":" + z;
+		const changed = axes != this.lastAxes;
+		if (changed)
+		{
+			this.heading = character.state.rotationY;
+			this.lastAxes = axes;
+			this.lastTarget = null;
+		}
+
+		const position = character.state.position;
+		const distanceToTarget = this.lastTarget ?
+			Math.hypot(this.lastTarget.x - position.x, this.lastTarget.z - position.z) : 0;
+		if (!changed && this.lastRun == run && distanceToTarget > 5)
+			return; // Keep walking rather than constantly restarting the pathfinder.
+
+		const now = Date.now();
+		if (now - this.lastSent < 120)
+			return; // Cap command frequency even if direction keys are spammed.
+
+		const scale = (run ? 26 : 18) / Math.hypot(x, z);
+		const sin = Math.sin(this.heading);
+		const cos = Math.cos(this.heading);
+		const targetX = position.x + (sin * z + cos * x) * scale;
+		const targetZ = position.z + (cos * z - sin * x) * scale;
+		if (!Number.isFinite(targetX) || !Number.isFinite(targetZ))
+		{
+			this.stop();
+			return;
+		}
+
+		// The command is ownership-checked and distance-limited in Commands.js.
+		Engine.PostNetworkCommand({
+			"type": "character-move",
+			"entities": [this.entity],
+			"x": Math.round(targetX * 100) / 100,
+			"z": Math.round(targetZ * 100) / 100,
+			"sprint": !!run
+		});
+		this.lastTarget = { "x": targetX, "z": targetZ };
+		this.lastRun = !!run;
+		this.lastSent = now;
+		this.moving = true;
+	}
+}
+
+/** Select an owned hero, or an infantry unit if the map has no hero yet. */
+function selectCharacter()
+{
+	if (Engine.GetPlayerID() < 0)
+		return;
+
+	const candidates = (Engine.GuiInterfaceCall("GetPlayerEntities") || [])
+		.slice().sort((a, b) => a - b)
+		.map(entity => ({ "entity": entity, "state": GetEntityState(entity) }))
+		.filter(({ state }) => state && state.position && state.unitAI && state.identity &&
+			state.identity.controllable && hasClass(state, "Unit") && controlsPlayer(state.player));
+	const character = candidates.find(({ state }) => hasClass(state, "Hero")) ||
+		candidates.find(({ state }) => hasClass(state, "Infantry")) || candidates[0];
+	if (!character)
+		return;
+
+	g_Selection.reset();
+	g_Selection.addList([character.entity]);
+	if (!g_ThirdPersonCameraEnabled)
+		toggleThirdPersonCamera();
+	else
+		updateThirdPersonCamera();
+}
