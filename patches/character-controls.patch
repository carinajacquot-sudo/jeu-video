diff --git a/binaries/data/config/default.cfg b/binaries/data/config/default.cfg
index 1ea9dc40..2c3ded0a 100644
--- a/binaries/data/config/default.cfg
+++ b/binaries/data/config/default.cfg
@@ -236,6 +236,14 @@ privatechat = "L"                     ; Toggle chat window and select the previo
 quicksave = "Shift+F5"
 quickload = "Shift+F8"
 
+[hotkey.character]
+forward = W, Z            ; Move in the character's facing direction (QWERTY/AZERTY)
+back = S                  ; Move backward relative to the facing direction
+left = A, Q               ; Move left (QWERTY/AZERTY)
+right = D                 ; Move right
+run = Shift               ; Sprint with the unit's native Run animation
+select = F4               ; Select a hero, or the first available infantry
+
 [hotkey.camera]
 reset = "R"                                   ; Reset camera rotation to default.
 follow = "F"                                  ; Toggle third-person view for the selected unit
@@ -607,9 +615,9 @@ height.smoothness = 0.5
 height.min = 16
 
 ; Third-person follow: camera stays low and behind the selected unit.
-thirdperson.distance = 9.0
-thirdperson.height = 4.4
-thirdperson.lookheight = 3.0
+thirdperson.distance = 7.0
+thirdperson.height = 3.2
+thirdperson.lookheight = 0.85
 thirdperson.shoulder = 1.0
 thirdperson.smoothness = 8.0
 thirdperson.fov = 68.0
diff --git a/binaries/data/mods/public/art/actors/units/astreval/hero_kenney.xml b/binaries/data/mods/public/art/actors/units/astreval/hero_kenney.xml
new file mode 100644
index 00000000..6a465daa
--- /dev/null
+++ b/binaries/data/mods/public/art/actors/units/astreval/hero_kenney.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<actor version="1">
+  <castshadow/>
+  <group>
+    <variant name="Kenney Mini Character">
+      <mesh>skeletal/astreval/character-male-a.dae</mesh>
+      <animations>
+        <animation name="Idle" file="astreval/character-male-a-idle.dae" speed="80"/>
+        <animation name="Walk" file="astreval/character-male-a-walk.dae" speed="12"/>
+        <animation name="Run" file="astreval/character-male-a-run.dae" speed="12"/>
+        <animation name="attack_melee" file="astreval/character-male-a-attack.dae" event="0.5" speed="100"/>
+        <animation name="Death" file="astreval/character-male-a-death.dae" speed="80"/>
+        <animation name="Jump" file="astreval/character-male-a-jump.dae" speed="100"/>
+      </animations>
+      <textures>
+        <texture name="baseTex" file="skeletal/astreval/colormap.png"/>
+      </textures>
+    </variant>
+  </group>
+  <material>default.xml</material>
+</actor>
