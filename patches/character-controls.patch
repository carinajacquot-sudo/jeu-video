+
+    # This mesh is a standalone rig. Export the reference geometry without clips,
+    # then export exactly one active action per animation .dae file.
+    def export(filename, animated):
+        result = bpy.ops.wm.collada_export(
+            filepath=str(destination / filename), selected=True,
+            include_children=False, include_armatures=True,
+            apply_modifiers=False, triangulate=True, use_texture_copies=False,
+            include_animations=animated, include_all_actions=False,
+            export_animation_type_selection='sample', sampling_rate=1)
