diff --git a/tools/convert_kenney.py b/tools/convert_kenney.py
new file mode 100644
index 00000000..dcfdf66c
--- /dev/null
+++ b/tools/convert_kenney.py
@@ -0,0 +1,98 @@
+"""Export Kenney Mini Characters GLB to 0 A.D. COLLADA assets.
+
+Run with Blender 3.6 LTS, the last Blender release with its built-in COLLADA
+exporter: blender -b -noaudio --python convert_kenney.py -- INPUT.glb OUTPUT_DIR
+The original GLB and the source ZIP's Textures/colormap.png are CC0 by Kenney.
+"""
+import bpy
+import os
+import sys
+from pathlib import Path
+
+
+def main():
+    args = sys.argv[sys.argv.index('--') + 1:]
+    source, destination = Path(args[0]).resolve(), Path(args[1]).resolve()
+    destination.mkdir(parents=True, exist_ok=True)
+
+    # GLB references an EXTERNAL PNG; keep Textures/colormap.png next to the GLB.
+    bpy.ops.import_scene.gltf(filepath=str(source))
+    armature = bpy.data.objects[source.stem]
+    parts = [bpy.data.objects[name] for name in ('body-mesh', 'head-mesh')]
+    for part in parts:
+        print('SKIN', part.name, 'parent', part.parent.name if part.parent else None,
+              'modifiers', [(m.type, m.object.name if m.type == 'ARMATURE' else '')
+                            for m in part.modifiers],
+              'groups', [group.name for group in part.vertex_groups])
+    print('ARMATURE', armature.name, [bone.name for bone in armature.data.bones])
+
+    # 0 A.D. expects one skinned geometry per actor: merge head and body while
+    # preserving their vertex groups, weights and the original CC0 colormap UVs.
+    bpy.ops.object.select_all(action='DESELECT')
+    for part in parts:
+        part.select_set(True)
+    bpy.context.view_layer.objects.active = parts[0]
+    bpy.ops.object.join()
+    mesh = parts[0]
+    mesh.name = 'kenney_character'
+    print('JOINED', len(mesh.data.vertices), 'vertices', len(mesh.data.polygons),
+          'faces', 'vertex groups', [group.name for group in mesh.vertex_groups],
+          'materials', [material.name for material in mesh.data.materials])
+
+    # Kenney's toy-scale model is 0.67 m tall. The 0 A.D. skeletal converter
+    # does NOT apply the COLLADA armature parent object's scale. Bake 2.6x
+    # directly into vertices, rest bones and action translation keys instead:
+    # the resulting mesh has a real height of about 1.75 m.
+    from mathutils import Matrix
+    scale = 2.6
+    mesh.data.transform(Matrix.Scale(scale, 4))
+    bpy.ops.object.select_all(action='DESELECT')
+    bpy.context.view_layer.objects.active = armature
+    bpy.ops.object.mode_set(mode='EDIT')
+    for bone in armature.data.edit_bones:
+        bone.head *= scale
+        bone.tail *= scale
+    bpy.ops.object.mode_set(mode='OBJECT')
+    for action in bpy.data.actions:
+        for curve in action.fcurves:
+            if curve.data_path.endswith('.location') or curve.data_path == 'location':
+                for key in curve.keyframe_points:
+                    key.co[1] *= scale
+                    key.handle_left[1] *= scale
+                    key.handle_right[1] *= scale
+
+    for obj in bpy.context.selected_objects:
